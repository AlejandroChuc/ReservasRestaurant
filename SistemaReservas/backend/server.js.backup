// Obtener horarios disponibles para un restaurante en una fecha específica
app.get('/api/horarios/disponibles', async (req, res) => {
  try {
    const { restaurante, fecha, personas, huesped } = req.query;

    console.log(`🔍 Buscando horarios disponibles:`, {
      restaurante,
      fecha,
      personas: parseInt(personas),
      huesped: parseInt(huesped)
    });

    if (!restaurante || !fecha || !personas || !huesped) {
      return res.status(400).json({
        success: false,
        message: 'Faltan parámetros requeridos: restaurante, fecha, personas, huesped'
      });
    }

    const idRestaurante = parseInt(restaurante);
    const numPersonas = parseInt(personas);
    const idHuesped = parseInt(huesped);

    // 1. Verificar que el huésped no tenga otra reserva ese día
    const [reservasDelDia] = await db.execute(`
      SELECT r.*, hr.bloque_comida, rest.nombre as restaurante_nombre
      FROM Reserva r
      JOIN Horario_Restaurante hr ON r.id_horario = hr.id_horario
      JOIN Restaurante rest ON hr.id_restaurante = rest.id_restaurante
      WHERE r.id_huesped = ? 
      AND r.fecha_reserva = ? 
      AND r.estado != 'Cancelada'
    `, [idHuesped, fecha]);

    if (reservasDelDia.length > 0) {
      return res.status(400).json({
        success: false,
        message: `Ya tienes una reserva para el ${fecha} en ${reservasDelDia[0].restaurante_nombre} (${reservasDelDia[0].bloque_comida})`,
        reservaExistente: reservasDelDia[0]
      });
    }

    // 2. Verificar que la fecha esté dentro del rango de estancia del huésped
    const [huesped_data] = await db.execute(`
      SELECT fecha_llegada, fecha_salida 
      FROM Huesped 
      WHERE id_huesped = ?
    `, [idHuesped]);

    if (huesped_data.length === 0) {
      return res.status(404).json({
        success: false,
        message: 'Huésped no encontrado'
      });
    }

    const fechaLlegada = new Date(huesped_data[0].fecha_llegada);
    const fechaSalida = new Date(huesped_data[0].fecha_salida);
    const fechaReserva = new Date(fecha);

    if (fechaReserva < fechaLlegada || fechaReserva > fechaSalida) {
      return res.status(400).json({
        success: false,
        message: `La fecha debe estar entre tu estancia (${fechaLlegada.toLocaleDateString()} - ${fechaSalida.toLocaleDateString()})`
      });
    }

    // 3. Obtener todos los horarios del restaurante
    const [horarios] = await db.execute(`
      SELECT 
        hr.id_horario,
        hr.bloque_comida,
        hr.hora_inicio,
        hr.hora_fin,
        r.capacidad_max
      FROM Horario_Restaurante hr
      JOIN Restaurante r ON hr.id_restaurante = r.id_restaurante
      WHERE hr.id_restaurante = ?
      ORDER BY 
        CASE hr.bloque_comida 
          WHEN 'Desayuno' THEN 1 
          WHEN 'Comida' THEN 2 
          WHEN 'Cena' THEN 3 
        END,
        hr.hora_inicio
    `, [idRestaurante]);

    if (horarios.length === 0) {
      return res.status(404).json({
        success: false,
        message: 'No hay horarios definidos para este restaurante'
      });
    }

    // 4. Para cada horario, calcular la capacidad disponible
    const horariosDisponibles = [];

    for (const horario of horarios) {
      // Obtener total de personas ya reservadas para este horario y fecha
      const [reservasExistentes] = await db.execute(`
        SELECT COALESCE(SUM(num_personas), 0) as total_reservado
        FROM Reserva 
        WHERE id_horario = ? 
        AND fecha_reserva = ? 
        AND estado != 'Cancelada'
      `, [horario.id_horario, fecha]);

      const totalReservado = reservasExistentes[0].total_reservado || 0;
      const capacidadDisponible = horario.capacidad_max - totalReservado;

      console.log(`📊 Horario ${horario.bloque_comida} ${horario.hora_inicio}:`, {
        capacidad_max: horario.capacidad_max,
        total_reservado: totalReservado,
        capacidad_disponible: capacidadDisponible,
        personas_solicitadas: numPersonas
      });

      // Si hay suficiente capacidad, incluir el horario
      if (capacidadDisponible >= numPersonas) {
        horariosDisponibles.push({
          id_horario: horario.id_horario,
          bloque_comida: horario.bloque_comida,
          hora_inicio: horario.hora_inicio,
          hora_fin: horario.hora_fin,
          capacidad_maxima: horario.capacidad_max,
          capacidad_disponible: capacidadDisponible,
          personas_reservadas: totalReservado
        });
      }
    }

    res.json({
      success: true,
      horarios: horariosDisponibles,
      totalHorarios: horariosDisponibles.length,
      fecha: fecha,
      restaurante: idRestaurante,
      personas_solicitadas: numPersonas
    });

  } catch (error) {
    console.error('❌ Error obteniendo horarios disponibles:', error);
    res.status(500).json({
      success: false,
      message: 'Error interno del servidor'
    });
  }
});

